{
  "id": "builtin.chrome-layout",
  "name": "Chrome layout",
  "version": "1.0.0",
  "type": "layout",
  "api": 1,
  "layout": {
    "modes": {
      "idle": {
        "top-left": [{ "id": "builtin.chrome-clock", "options": { "size": "large" } }],
        "top-right": [{ "id": "builtin.chrome-rings" }],
        "bottom": [{ "id": "builtin.chrome-tasks" }]
      },
      "attention": {
        "top-left": [{ "id": "builtin.chrome-clock", "options": { "size": "small" } }],
        "top-right": [{ "id": "builtin.chrome-rings" }],
        "center": [{ "id": "builtin.chrome-approval" }],
        "bottom": [{ "id": "builtin.chrome-tasks" }]
      },
      "secondary": {
        "top-left": [{ "id": "builtin.chrome-clock", "options": { "size": "large" } }]
      }
    }
  }
}
