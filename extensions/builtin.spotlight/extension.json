{
  "id": "builtin.spotlight",
  "name": "Spotlight",
  "version": "1.0.0",
  "type": "layout",
  "api": 1,
  "layout": {
    "modes": {
      "idle": {
        "center": [{ "id": "builtin.clock", "options": { "size": "large" } }],
        "top-right": [{ "id": "builtin.limit-rings" }],
        "bottom": [{ "id": "builtin.task-row" }]
      },
      "attention": {
        "top-left": [{ "id": "builtin.clock", "options": { "size": "small" } }],
        "top-right": [{ "id": "builtin.limit-rings" }],
        "center": [{ "id": "builtin.approval-card" }],
        "bottom": [{ "id": "builtin.task-row" }]
      },
      "secondary": {
        "center": [{ "id": "builtin.clock", "options": { "size": "large" } }]
      }
    }
  }
}
