{
  "id": "builtin.chrome-scene",
  "name": "Chrome scene",
  "version": "1.0.0",
  "type": "background",
  "api": 1,
  "entry": "index.js",
  "options": {
    "fps": { "type": "number", "default": 30, "min": 10, "max": 60, "label": "Frames per second" },
    "scale": { "type": "number", "default": 0.5, "min": 0.25, "max": 1, "label": "Render size" },
    "grain": { "type": "number", "default": 0.6, "min": 0, "max": 1, "label": "Film grain" }
  }
}
